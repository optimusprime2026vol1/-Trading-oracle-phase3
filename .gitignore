# Secrets -- never committed, ever.
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/

# Runtime data -- generated, not source. Keep the folder via .gitkeep,
# ignore everything actually written into it at runtime.
logs/*.log
logs/*.log.*
logs/*.jsonl
database/*.db
database/*.sqlite3

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Copy this file to .env and fill in real values. .env is git-ignored --
# never commit real secrets. In CI, the same names are set as GitHub Secrets.
#
# Nothing here is read yet in Phase 1 -- these are stubs for Phase 2 (data
# layer), which wires up Zerodha Kite Connect per the master spec.

# --- Zerodha Kite Connect (Phase 2) ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Access token is short-lived (expires daily) and generated via the Kite
# Connect login flow -- it is never a long-term credential to hardcode.
ZERODHA_ACCESS_TOKEN=

# --- Optional: news data provider (later phase) ---
NEWS_API_KEY=
